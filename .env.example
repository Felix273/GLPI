# Public ports
GLPI_PORT=8095
FRONTEND_PORT=8091

# Internal frontend-to-GLPI URL
GLPI_BACKEND_URL=http://glpi

# Images
GLPI_IMAGE=glpi/glpi:10.0.26
FRONTEND_IMAGE=glpi-frontend-local:1.1

# Existing Docker resources
GLPI_NETWORK=glpi-network
GLPI_DATA_VOLUME=5460f57d138e1c1d896b6ac3003fb99c9ccf0c85e60efdbe593d3d02bf736cf4

# GLPI database credentials (do NOT commit .env.glpi with real values)
# GLPI_DB_HOST=localhost
# GLPI_DB_USER=glpi
# GLPI_DB_PASSWORD=changeme
# GLPI_DB_NAME=glpi

# Frontend secret key
# SETTINGS_SECRET_KEY=generate-a-random-string

# Optional browser E2E credentials for local validation
# E2E_BASE_URL=http://127.0.0.1:8091
# E2E_GLPI_URL=http://127.0.0.1:8095
# E2E_GLPI_USER_TOKEN=replace-with-test-user-token
# E2E_GLPI_APP_TOKEN=
# E2E_ITEM_TYPE=Computer
# E2E_ITEM_ID=
# E2E_REQUIRED=0
